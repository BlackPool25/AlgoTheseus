# Production env example — copy to .env.production and fill in real values.
# The frontend is static (Cloudflare Pages); the API runs on Cloud Run.
# Local dev keeps same-origin (Vite proxy), so leave VITE_API_URL unset there.

# Cloud Run API origin (no trailing slash). Must match the connect-src
# allowlist in public/_headers (currently the https://api.example.com
# placeholder) — update both together.
VITE_API_URL=https://<api>

# Canonical site origin (no trailing slash) used for absolute SEO URLs.
# Vite replaces %VITE_SITE_URL% in index.html at build time (canonical,
# og:url, og:image, twitter:image). Production builds MUST set this, e.g.
# VITE_SITE_URL=https://www.example.com — the https://www.example.com value
# below is a PLACEHOLDER, not a real domain. If unset, the literal
# "%VITE_SITE_URL%" token ships in dist/index.html; fail the deploy if
# `grep -r "%VITE_" dist/` matches anything. Same placeholder domain appears
# in public/sitemap.xml, public/robots.txt, public/_redirects, and
# public/site.webmanifest context — replace everywhere before launch.
VITE_SITE_URL=https://www.example.com
